{
  "name": "raajya-bedrock-addon",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "description": "RAAJYA — a Minecraft Bedrock Edition add-on featuring a Commander Stone, a reusable Royal Soldier Spawner, and Royal Guard recruitment with persistent ownership.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs && node scripts/package.mjs",
    "package": "node scripts/package.mjs",
    "site": "node scripts/prepare-site.mjs",
    "textures": "node scripts/gen-textures.mjs",
    "ci": "npm run typecheck && npm test && npm run validate && npm run build"
  },
  "devDependencies": {
    "@minecraft/common": "1.3.0",
    "@minecraft/server": "2.11.0",
    "@minecraft/vanilla-data": "1.26.60",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
